#!/usr/bin/env bash
# Blocks a commit when staged changes contain a secret. Enable with `make hooks`.
set -euo pipefail

if ! command -v gitleaks >/dev/null; then
  echo "pre-commit: gitleaks is not installed. Run: brew install gitleaks" >&2
  exit 1
fi

exec gitleaks git --pre-commit --staged --redact --no-banner --verbose .
